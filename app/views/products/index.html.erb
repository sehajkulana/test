<% content_for :head do %>
  <script type="module" src="https://unpkg.com/@splinetool/viewer/build/spline-viewer.js"></script>
  <script>
    (() => {
      const initOrbitalTimeline = () => {
        document.querySelectorAll(".orbital-stage").forEach((stage) => {
          if (stage.orbitalTimelineCleanup) stage.orbitalTimelineCleanup();

          const orbit = stage.querySelector(".orbital-system");
          const nodes = Array.from(stage.querySelectorAll(".orbital-node"));
          let rotationAngle = 0;
          let activeNodeId = null;
          let autoRotate = true;
          let timerId;
          let centeringTimeout;

          const relatedIdsFor = (node) => (
            node.dataset.relatedIds || ""
          ).split(",").filter(Boolean).map((id) => Number(id));

          const getRadius = () => {
            const width = stage.getBoundingClientRect().width;
            return Math.max(118, Math.min(200, (width - 180) / 2));
          };

          const updatePositions = () => {
            const radius = getRadius();

            nodes.forEach((node, index) => {
              const angle = ((index / nodes.length) * 360 + rotationAngle) % 360;
              const radian = angle * Math.PI / 180;
              const x = radius * Math.cos(radian);
              const y = radius * Math.sin(radian);
              const depth = (1 + Math.sin(radian)) / 2;

              node.style.transform = `translate(${x}px, ${y}px)`;
              node.style.zIndex = node.classList.contains("is-active") ? 200 : Math.round(100 + 50 * Math.cos(radian));
              node.style.opacity = node.classList.contains("is-active") ? 1 : Math.max(0.42, 0.42 + 0.58 * depth);
              node.style.setProperty("--orbital-energy-size", `${Number(node.dataset.energy) * 0.5 + 40}px`);
            });
          };

          const updateState = () => {
            const activeNode = nodes.find((node) => Number(node.dataset.nodeId) === activeNodeId);
            const relatedIds = activeNode ? relatedIdsFor(activeNode) : [];

            nodes.forEach((node) => {
              const id = Number(node.dataset.nodeId);
              node.classList.toggle("is-active", id === activeNodeId);
              node.classList.toggle("is-related", relatedIds.includes(id));
              node.classList.toggle("is-muted", activeNodeId !== null && id !== activeNodeId && !relatedIds.includes(id));
            });
          };

          const centerOnNode = (id) => {
            const index = nodes.findIndex((node) => Number(node.dataset.nodeId) === id);
            if (index < 0) return;

            rotationAngle = 270 - (index / nodes.length) * 360;
          };

          const activateNode = (id) => {
            activeNodeId = Number(id);
            autoRotate = false;
            stage.classList.add("is-centering");
            window.clearTimeout(centeringTimeout);
            centerOnNode(activeNodeId);
            updateState();
            updatePositions();
            centeringTimeout = window.setTimeout(() => {
              stage.classList.remove("is-centering");
            }, 720);
          };

          const clearActive = () => {
            activeNodeId = null;
            autoRotate = true;
            stage.classList.remove("is-centering");
            window.clearTimeout(centeringTimeout);
            updateState();
          };

          const onStageClick = (event) => {
            if (event.target === stage || event.target === orbit) clearActive();
          };

          const nodeHandlers = nodes.map((node) => {
            const handler = (event) => {
              event.stopPropagation();
              if (event.target.closest(".orbital-card")) return;

              const id = Number(node.dataset.nodeId);
              if (activeNodeId === id) {
                clearActive();
              } else {
                activateNode(id);
              }
            };

            node.addEventListener("click", handler);
            return [node, handler];
          });

          const linkHandlers = Array.from(stage.querySelectorAll(".orbital-link")).map((link) => {
            const handler = (event) => {
              event.stopPropagation();
              activateNode(link.dataset.nodeIdParam);
            };

            link.addEventListener("click", handler);
            return [link, handler];
          });

          const tick = () => {
            if (autoRotate) {
              rotationAngle = (rotationAngle + 0.3) % 360;
              updatePositions();
            }
          };

          stage.addEventListener("click", onStageClick);
          updatePositions();
          timerId = window.setInterval(tick, 50);

          stage.orbitalTimelineCleanup = () => {
            window.clearInterval(timerId);
            window.clearTimeout(centeringTimeout);
            stage.removeEventListener("click", onStageClick);
            nodeHandlers.forEach(([node, handler]) => node.removeEventListener("click", handler));
            linkHandlers.forEach(([link, handler]) => link.removeEventListener("click", handler));
          };
        });
      };

      document.addEventListener("DOMContentLoaded", initOrbitalTimeline);
      document.addEventListener("turbo:load", initOrbitalTimeline);
      document.addEventListener("turbo:before-cache", () => {
        document.querySelectorAll(".orbital-stage").forEach((stage) => {
          if (stage.orbitalTimelineCleanup) stage.orbitalTimelineCleanup();
        });
      });
    })();
  </script>
<% end %>

